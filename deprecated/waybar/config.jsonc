{
  "layer": "top",
  "output": ["*"],
  "height": 20,
  "exclusive": true,
  "passthrough": false,
  "reload_style_on_change": true,
  "include": [
    "$XDG_CONFIG_HOME/waybar/modules/*json*",
    "$XDG_CONFIG_HOME/waybar/includes/modules.json"
  ],
  "modules-left": ["group/pill#left1", "group/pill#left2", "group/pill#left3"],
  "group/pill#left1": {
    "orientation": "inherit",
    "modules": ["custom/controlcentre"]
  },
  "group/pill#left2": {
    "orientation": "inherit",
    "modules": ["hyprland/workspaces"]
  },
  "group/pill#left3": {
    "orientation": "inherit",
    "modules": ["cpu", "memory"]
  },
  "modules-center": ["group/pill#center"],
  "group/pill#center": {
    "orientation": "inherit",
    "modules": ["clock", "custom/weather"]
  },
  "modules-right": [
    "group/pill#right2",
    "group/pill#right1",
    "group/pill#right3"
  ],

  "group/pill#right1": {
    "orientation": "inherit",
    "modules": [
      "group/hide-tray",
      "backlight",
      "pulseaudio",
      "network",
      "bluetooth",
      "privacy"
    ]
  },
  "group/pill#right2": {
    "orientation": "inherit",
    "modules": ["hyprland/language"]
  },
  "group/pill#right3": {
    "orientation": "inherit",
    "modules": [
      "power-profiles-daemon",
      "custom/power"
    ]
  }
}
